[user]
	name = Rasti Tkac
	email = rasti@webkinder.ch
	signingkey = ssh-rsa 
[core]
	excludesfile = /Users/rastitkac/.gitignore_global
	editor = /usr/bin/vim
[init]
	defaultBranch = main
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[commit]
  gpgsign = true
